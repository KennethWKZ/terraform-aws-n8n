# Terragrunt Environment Variables Configuration
# Copy this file to .env and customize the values for your deployment
# Source before running Terragrunt: export $(cat .env | xargs)

# =============================================================================
# TERRAGRUNT REMOTE STATE CONFIGURATION
# Required for all deployments
# =============================================================================

# AWS region for Terragrunt operations
TG_AWS_REGION=us-east-1

# AWS profile to use for authentication (optional, useful for multi-account deployments)
# If not set, uses default AWS credentials chain
TG_AWS_PROFILE=my-aws-profile

# S3 bucket name for storing Terraform state (must be globally unique)
TG_STATE_BUCKET=my-terraform-state-bucket

# AWS region where the S3 state bucket is located (defaults to TG_AWS_REGION if not set)
TG_STATE_REGION=us-east-1

# DynamoDB table name for state locking
TG_LOCKFILE=1

# =============================================================================
# AWS RESOURCE TAGS (OPTIONAL)
# Default tags applied to all AWS resources created by Terragrunt
# =============================================================================

# Environment tag (e.g., dev, staging, prod)
TG_TAG_ENV=prod

# Region tag (e.g., us-east-1, global, multi-region)
TG_TAG_REGION=global

# Team tag (e.g., engineering, devops, platform)
TG_TAG_TEAM=engineering

# Application tag
TG_TAG_APP=n8n

# =============================================================================
# N8N COMMON CONFIGURATION
# Required/recommended for all deployment scenarios
# =============================================================================

# Prefix for all AWS resources (used to identify and organize resources)
N8N_PREFIX=n8n-demo

# Number of main ECS tasks to run (default: 1)
# Main instances handle webhooks, triggers, and queue job submissions
N8N_DESIRED_COUNT=1

# Number of worker ECS tasks to run (default: 2)
# Worker instances process queued workflow executions
N8N_WORKER_DESIRED_COUNT=2

# Worker CPU units (default: 1024 = 1 vCPU)
# Valid values: 256, 512, 1024, 2048, 4096
N8N_WORKER_CPU=1024

# Worker memory in MB (default: 2048 = 2 GB)
# Must be compatible with CPU value (see AWS Fargate docs)
N8N_WORKER_MEMORY=2048

# Worker concurrency limit (default: 20)
# Controls how many workflow executions can run simultaneously per worker
# Higher values increase throughput but require more resources
N8N_WORKER_CONCURRENCY=20

# N8n Docker image to deploy
N8N_CONTAINER_IMAGE=n8nio/n8n:latest

# ECS Fargate capacity type: FARGATE or FARGATE_SPOT (SPOT is cheaper)
N8N_FARGATE_TYPE=FARGATE_SPOT

# =============================================================================
# ELASTICACHE/VALKEY CONFIGURATION
# Choose either Serverless (recommended) or Node-based deployment
# =============================================================================

# Option 1: Valkey Serverless (recommended for production)
# Maximum ECPUs per second (default: 5000)
# 1 ECPU = 1 vCPU + 4 GiB memory, adjusts automatically based on load
N8N_VALKEY_SERVERLESS_ECPU=5000

# Maximum storage in GB (default: 1)
# Storage scales automatically from 0 to this value
N8N_VALKEY_SERVERLESS_STORAGE=1

# Valkey engine version (default: 8)
# Version 8 provides Redis 7.2 compatibility
N8N_VALKEY_SERVERLESS_ENGINE_VERSION=8

# =============================================================================
# DATABASE CONFIGURATION (AURORA SERVERLESS V2)
# PostgreSQL database configuration for n8n
# =============================================================================

# Database name (default: n8n)
N8N_DB_NAME=n8n

# Database master username (default: n8n_admin)
N8N_DB_MASTER_USERNAME=n8n_admin

# PostgreSQL engine version (default: 17.5)
# Use major.minor format (e.g., 17.5, 16.4, 15.8)
N8N_DB_ENGINE_VERSION=17.5

# Minimum Aurora Capacity Units (ACUs) (default: 0.5)
# 1 ACU = 2 GiB memory, can scale down to 0.5 ACU minimum
N8N_DB_MIN_CAPACITY=0.5

# Maximum Aurora Capacity Units (ACUs) (default: 4)
# Database will automatically scale between min and max based on load
N8N_DB_MAX_CAPACITY=4

# Number of database instances (default: 1)
# Set to 2+ for high availability across multiple AZs
N8N_DB_INSTANCE_COUNT=1

# Enable deletion protection (default: false for dev, true for prod)
# Prevents accidental database deletion
N8N_DB_DELETION_PROTECTION=false

# Skip final snapshot on deletion (default: true for dev, false for prod)
# Set to false in production to create final snapshot before deletion
N8N_DB_SKIP_FINAL_SNAPSHOT=true

# =============================================================================
# N8N PERFORMANCE TUNING (OPTIONAL)
# Configure concurrency and database connection pool sizes for optimal performance
# =============================================================================

# Main instance concurrency limit (default: 15)
# Controls how many workflow executions can run simultaneously on main instances
# Main instances handle webhooks, triggers, and queue job submissions
# Lower values reduce resource usage, higher values increase throughput
N8N_MAIN_CONCURRENCY=15

# Main instance database pool size (default: 10)
# Number of concurrent database connections for main instances
# Should be sized based on main_concurrency and expected database load
# Formula: pool_size ≥ concurrency * 0.5 to 1.0
N8N_MAIN_POOL_SIZE=10

# Worker instance database pool size (default: 20)
# Number of concurrent database connections for worker instances
# Workers process queued executions and require more database connections
# Formula: pool_size ≥ worker_concurrency * 0.75 to 1.5
N8N_WORKER_POOL_SIZE=20

# =============================================================================
# WAF CONFIGURATION (OPTIONAL)
# Associate AWS WAF Web ACL with the Application Load Balancer
# =============================================================================

# AWS WAF Web ACL ARN (optional)
# If provided, the Web ACL will be associated with the ALB for security protection
# Example: arn:aws:wafv2:us-east-1:123456789012:global/webacl/n8n-waf/a1234567-b890-1234-5678-c90d1e2f3456
N8N_WAF_ARN=

# =============================================================================
# BROWSERLESS CONFIGURATION (OPTIONAL)
# Enable browser automation capabilities for n8n workflows
# =============================================================================

# Enable Browserless service (default: 0/false)
# Set to 1/true to deploy Browserless container alongside n8n
N8N_BROWSERLESS_ENABLED=0

# Browserless authentication token (required if enabled)
# Generate a secure random token for authenticating to Browserless
# Example: openssl rand -base64 32
N8N_BROWSERLESS_TOKEN=

# =============================================================================
# SMTP EMAIL CONFIGURATION (OPTIONAL)
# Configure n8n to send emails via SMTP (e.g., AWS SES, Gmail, SendGrid)
# =============================================================================

# SMTP server host (e.g., email-smtp.us-east-1.amazonaws.com for AWS SES)
N8N_SMTP_HOST=email-smtp.us-east-1.amazonaws.com

# SMTP server port (465 for implicit SSL/TLS, 587 for STARTTLS)
# AWS SES uses port 465 with implicit SSL
N8N_SMTP_PORT=587

# SMTP username (for AWS SES, this is your SMTP IAM user access key ID)
N8N_SMTP_USER=AKIAIOSFODNN7EXAMPLE

# SMTP password (for AWS SES, this is your SMTP IAM user secret access key)
N8N_SMTP_PASS=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Email sender address (must be verified in AWS SES if using SES)
N8N_SMTP_SENDER=noreply@example.com

# Enable SMTP SSL/TLS (true for port 465, false for port 587 with STARTTLS)
N8N_SMTP_SSL=false

# =============================================================================
# ROUTE53 DNS CONFIGURATION (OPTIONAL)
# Automatically create Route53 DNS record pointing to the ALB
# =============================================================================

# Route53 hosted zone ID (optional, e.g., Z1234567890ABC)
# If provided, a DNS A record will be created pointing to the ALB
N8N_ROUTE53_ZONE_ID=Z1234567890ABC

# Route53 record name (optional, e.g., 'n8n' for n8n.example.com)
# This is the subdomain/hostname to create in the hosted zone
N8N_ROUTE53_RECORD_NAME=n8n

# =============================================================================
# SCENARIO 1: NEW VPC (AUTOMATIC CREATION)
# Only N8N_PREFIX is required, other settings are optional
# =============================================================================

# Example configuration:
# N8N_PREFIX=n8n-new-vpc
# N8N_DESIRED_COUNT=1
# N8N_CONTAINER_IMAGE=n8nio/n8n:latest
# N8N_FARGATE_TYPE=FARGATE_SPOT

# =============================================================================
# SCENARIO 2: EXISTING VPC WITH PUBLIC SUBNETS
# Required variables for existing VPC deployment
# =============================================================================

# VPC ID where N8n will be deployed
N8N_VPC_ID=vpc-xxxxxxxxxxxxx

# Comma-separated list of subnet IDs for ECS tasks (public subnets)
N8N_SUBNET_IDS=subnet-public1xxxxx,subnet-public2xxxxx

# Comma-separated list of public subnet IDs for ALB (same as N8N_SUBNET_IDS for public deployment)
N8N_PUBLIC_SUBNET_IDS=subnet-public1xxxxx,subnet-public2xxxxx

# Optional: ACM Certificate ARN for HTTPS support
N8N_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxx

# Optional: Custom URL for N8n (must include trailing slash if specified)
N8N_URL=https://n8n.example.com/

# =============================================================================
# SCENARIO 3: EXISTING VPC WITH PRIVATE SUBNETS (PRODUCTION RECOMMENDED)
# Required variables for private subnet deployment (requires NAT Gateway)
# =============================================================================

# VPC ID where N8n will be deployed
# N8N_VPC_ID=vpc-xxxxxxxxxxxxx

# Comma-separated list of PRIVATE subnet IDs for ECS tasks
# N8N_SUBNET_IDS=subnet-private1xxxxx,subnet-private2xxxxx

# Comma-separated list of PUBLIC subnet IDs for ALB
# N8N_PUBLIC_SUBNET_IDS=subnet-public1xxxxx,subnet-public2xxxxx

# Optional: ACM Certificate ARN for HTTPS support
# N8N_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxx

# Optional: Custom URL for N8n (must include trailing slash if specified)
# N8N_URL=https://n8n.example.com/

# =============================================================================
# USAGE INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Edit .env and set your values (do NOT commit .env to version control!)
#
# 3. Source the environment variables:
#    export $(cat .env | xargs)
#
# 4. Navigate to your Terragrunt example directory:
#    cd examples/terragrunt/new-vpc           # or existing-vpc, or existing-vpc-private-subnets
#
# 5. Run Terragrunt commands:
#    terragrunt init
#    terragrunt plan
#    terragrunt apply
#
# 6. To deploy to a different environment, update .env and re-source:
#    export $(cat .env | xargs)
#    terragrunt apply
#
# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
#
# - Add .env to .gitignore to prevent committing sensitive values
# - Use different .env files for different environments (e.g., .env.dev, .env.prod)
# - Store production secrets in a secure secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Rotate credentials regularly
# - Use IAM roles and least-privilege access policies
# - Enable MFA for AWS accounts with production access
#
# =============================================================================
